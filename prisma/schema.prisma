generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id                  String   @id @default(cuid())
  status              String   @default("Pending")
  pickupDate          String?
  pickupTime          String?
  pickupLocation      String?
  deliveryLocation    String?
  vehicleType         String?
  goodsDescription    String?
  name                String?
  phone               String?
  email               String?
  specialInstructions String?
  createdAt           DateTime @default(now())
}

model Shipment {
  id                String   @id
  status            String   @default("Pending")
  origin            String?
  destination       String?
  estimatedDelivery String?
  currentLocation   String?
  consigneeName     String?
  goodsDescription  String?
  date              String?
  driverId          String?
  history           Json     @default("[]")
  updatedAt         DateTime @updatedAt
}

model Driver {
  id          String @id @default(cuid())
  name        String
  phone       String
  truckNumber String
  truckType   String
  city        String
  status      String @default("Active")
}

model Pricing {
  id               Int      @id @default(1)
  mazda            Float
  hyundai          Float
  shehzore         Float
  container        Float
  perKmRate        Float
  weightMultiplier Float
  updatedAt        DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  date      String
  author    String
  category  String
  content   String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  comment   String
  location  String
  rating    Int
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}
